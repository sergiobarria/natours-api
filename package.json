{
  "name": "natours-api",
  "version": "0.0.1",
  "description": "Natours HTTP API",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" \"*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./jest.config.ts",
    "test:watch": "pnpm test -- --watch",
    "test:cov": "pnpm test -- --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --config ./jest.config.ts --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-integration.config.ts",
    "test:redis": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-redis.config.ts",
    "test:processes": "tsx scripts/processes/check.ts",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed:canonical": "tsx scripts/database/seed-canonical.ts",
    "db:seed:demo": "tsx scripts/database/seed-demo.ts",
    "db:seed": "tsx scripts/database/seed.ts",
    "db:purge": "tsx scripts/database/purge.ts",
    "db:reset": "tsx scripts/database/reset.ts",
    "openapi:generate": "tsx scripts/openapi/generate.ts",
    "openapi:check": "tsx scripts/openapi/check.ts",
    "jobs:list-failed": "tsx scripts/jobs/list-failed.ts",
    "jobs:inspect": "tsx scripts/jobs/inspect.ts",
    "jobs:replay": "tsx scripts/jobs/replay.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@scalar/nestjs-api-reference": "^1.2.12",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "1.6.25",
    "bullmq": "6.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.1.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.22.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "resend": "6.18.1",
    "rxjs": "^7.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "17.8.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
