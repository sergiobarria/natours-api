          "value": "(\"tours\".\"rating_count\" = 0 AND \"tours\".\"rating_average\" IS NULL) OR (\"tours\".\"rating_count\" > 0 AND \"tours\".\"rating_average\" BETWEEN 1 AND 5)"
        },
