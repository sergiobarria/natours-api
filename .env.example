NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql://postgres@localhost:5432/natours_dev
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/natours_test
DATABASE_RESET_ALLOWED_DATABASES=natours_dev,natours_test
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=natours

JOBS_QUEUE_NAME=natours-jobs
JOBS_WORKER_CONCURRENCY=4

TRUSTED_PROXY_CIDRS=
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_GLOBAL_TTL_MS=60000
RATE_LIMIT_GLOBAL_BLOCK_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_BLOCK_MS=300000
RATE_LIMIT_ACCOUNT_LIMIT=30
RATE_LIMIT_ACCOUNT_TTL_MS=60000
RATE_LIMIT_ACCOUNT_BLOCK_MS=60000

# Resend is the selected production provider. The live adapter arrives with identity delivery.
EMAIL_PROVIDER=fake
RESEND_API_KEY=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Natours

OBJECT_STORAGE_PROVIDER=fake
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=http://localhost:3000/media
R2_REGION=auto
