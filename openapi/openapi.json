    "/api/v1/tours": {
      "get": {
        "operationId": "ToursController_list_v1",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": { "maxLength": 160, "type": "string" }
          },
          {
            "in": "query",
            "name": "difficulty",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "in": "query",
            "name": "minPrice",
            "required": false,
            "schema": { "minimum": 0, "type": "number" }
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": { "minimum": 0, "type": "number" }
          },
          {
            "in": "query",
            "name": "minDuration",
            "required": false,
            "schema": { "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "maxDuration",
            "required": false,
            "schema": { "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "minGroupSize",
            "required": false,
            "schema": { "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "maxGroupSize",
            "required": false,
            "schema": { "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "minRating",
            "required": false,
            "schema": { "maximum": 5, "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "maxRating",
            "required": false,
            "schema": { "maximum": 5, "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": { "default": "name", "type": "string" }
          },
          {
            "in": "query",
            "name": "sortOrder",
            "required": false,
            "schema": { "default": "asc", "type": "string" }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": { "default": 1, "minimum": 1, "type": "number" }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": { "description": "Active public tour catalog." }
        },
        "tags": ["tours"]
      },
      "post": {
        "operationId": "ToursController_create_v1",
