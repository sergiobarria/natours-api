{
  "components": {
    "schemas": {
      "ChangeEmailDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          },
          "newEmail": { "format": "email", "type": "string" }
        },
        "required": ["currentPassword", "newEmail"],
        "type": "object"
      },
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          },
          "newPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["currentPassword", "newPassword"],
        "type": "object"
      },
      "ConfirmPasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["currentPassword"],
        "type": "object"
      },
      "CreateTourDto": {
        "properties": {
          "description": {
            "maxLength": 10000,
            "nullable": true,
            "type": "string"
          },
          "difficulty": {
            "enum": ["easy", "moderate", "difficult"],
            "type": "string"
          },
          "discountPercentage": {
            "maximum": 99.99,
            "minimum": 0.01,
            "nullable": true,
            "type": "number"
          },
          "durationDays": { "maximum": 3650, "minimum": 1, "type": "number" },
          "guideIds": {
            "items": { "format": "uuid", "type": "string" },
            "maxItems": 4,
            "type": "array"
          },
          "isActive": { "default": false, "type": "boolean" },
          "leadGuideId": { "format": "uuid", "type": "string" },
          "maximumGroupSize": {
            "maximum": 10000,
            "minimum": 1,
            "type": "number"
          },
          "name": { "maxLength": 160, "type": "string" },
          "price": {
            "description": "Price in USD cents.",
            "minimum": 0,
            "type": "number"
          },
          "startLocation": { "$ref": "#/components/schemas/TourLocationDto" },
          "summary": { "maxLength": 500, "type": "string" }
        },
        "required": [
          "name",
          "summary",
          "durationDays",
          "maximumGroupSize",
          "difficulty",
          "price",
          "startLocation",
          "leadGuideId"
        ],
        "type": "object"
      },
      "ReplaceGuideTeamDto": {
        "properties": {
          "guideIds": {
            "items": { "format": "uuid", "type": "string" },
            "maxItems": 4,
            "type": "array"
          },
          "leadGuideId": { "format": "uuid", "type": "string" }
        },
        "required": ["leadGuideId", "guideIds"],
        "type": "object"
      },
      "TourLocationDto": {
        "properties": {
          "address": { "maxLength": 300, "nullable": true, "type": "string" },
          "latitude": { "maximum": 90, "minimum": -90, "type": "number" },
          "longitude": { "maximum": 180, "minimum": -180, "type": "number" },
          "name": { "maxLength": 160, "type": "string" }
        },
        "required": ["name", "latitude", "longitude"],
        "type": "object"
      },
      "UpdateProfileDto": {
        "properties": { "name": { "maxLength": 100, "type": "string" } },
        "required": ["name"],
        "type": "object"
      },
      "UpdateRoleDto": {
        "properties": {
          "role": {
            "enum": ["user", "guide", "lead-guide", "admin"],
            "type": "string"
          }
        },
        "required": ["role"],
        "type": "object"
      },
      "UpdateTourDto": {
        "properties": {
          "description": {
            "maxLength": 10000,
            "nullable": true,
            "type": "string"
          },
          "difficulty": {
            "enum": ["easy", "moderate", "difficult"],
            "type": "string"
          },
          "discountPercentage": {
            "maximum": 99.99,
            "minimum": 0.01,
            "nullable": true,
            "type": "number"
          },
          "durationDays": { "maximum": 3650, "minimum": 1, "type": "number" },
          "isActive": { "type": "boolean" },
          "maximumGroupSize": {
            "maximum": 10000,
            "minimum": 1,
            "type": "number"
          },
          "name": { "maxLength": 160, "type": "string" },
          "price": {
            "description": "Price in USD cents.",
            "minimum": 0,
            "type": "number"
          },
          "startLocation": { "$ref": "#/components/schemas/TourLocationDto" },
          "summary": { "maxLength": 500, "type": "string" }
        },
        "type": "object"
      }
    },
    "securitySchemes": { "bearerAuth": { "scheme": "bearer", "type": "http" } }
  },
  "info": {
    "contact": {},
    "description": "HTTP API for the Natours application",
    "title": "Natours API",
    "version": "1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "AppController_describe_v1",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "data": { "name": "natours-api", "version": "1" }
                  },
                  "properties": {
                    "data": {
                      "properties": {
                        "name": { "example": "natours-api", "type": "string" },
                        "version": { "example": "1", "type": "string" }
                      },
                      "required": ["name", "version"],
                      "type": "object"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "example": "INTERNAL_SERVER_ERROR",
                          "type": "string"
                        },
                        "details": { "nullable": true },
                        "message": {
                          "example": "An unexpected error occurred.",
                          "type": "string"
                        },
                        "requestId": {
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                          "type": "string"
                        }
                      },
                      "required": ["code", "message", "requestId"],
                      "type": "object"
                    }
                  },
                  "required": ["error"],
                  "type": "object"
                }
              }
            },
            "description": "Unexpected internal failure"
          }
        },
        "summary": "Describe the API",
        "tags": ["application"]
      }
    },
    "/api/v1/admin/tours/{tourId}": {
