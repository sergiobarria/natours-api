            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "example": "INTERNAL_SERVER_ERROR",
                          "type": "string"
                        },
                        "details": { "nullable": true },
                        "message": {
                          "example": "An unexpected error occurred.",
                          "type": "string"
                        },
                        "requestId": {
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                          "type": "string"
                        }
                      },
                      "required": ["code", "message", "requestId"],
                      "type": "object"
                    }
                  },
                  "required": ["error"],
                  "type": "object"
                }
              }
            },
