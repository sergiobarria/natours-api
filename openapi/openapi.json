{
  "components": {
    "schemas": {
      "ChangeEmailDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          },
          "newEmail": { "format": "email", "type": "string" }
        },
        "required": ["currentPassword", "newEmail"],
        "type": "object"
      },
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          },
          "newPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["currentPassword", "newPassword"],
        "type": "object"
      },
      "ConfirmPasswordDto": {
        "properties": {
          "currentPassword": {
            "format": "password",
            "maxLength": 128,
            "minLength": 8,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": ["currentPassword"],
        "type": "object"
      },
      "UpdateProfileDto": {
        "properties": { "name": { "maxLength": 100, "type": "string" } },
        "required": ["name"],
        "type": "object"
      },
      "UpdateRoleDto": {
        "properties": {
          "role": {
            "enum": ["user", "guide", "lead-guide", "admin"],
            "type": "string"
          }
        },
        "required": ["role"],
        "type": "object"
      }
    },
    "securitySchemes": { "bearerAuth": { "scheme": "bearer", "type": "http" } }
  },
  "info": {
    "contact": {},
    "description": "HTTP API for the Natours application",
    "title": "Natours API",
    "version": "1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "AppController_describe_v1",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "data": { "name": "natours-api", "version": "1" }
                  },
                  "properties": {
                    "data": {
                      "properties": {
                        "name": { "example": "natours-api", "type": "string" },
                        "version": { "example": "1", "type": "string" }
                      },
                      "required": ["name", "version"],
                      "type": "object"
                    }
                  },
                  "required": ["data"],
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "example": "INTERNAL_SERVER_ERROR",
                          "type": "string"
                        },
                        "details": { "nullable": true },
                        "message": {
                          "example": "An unexpected error occurred.",
                          "type": "string"
                        },
                        "requestId": {
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                          "type": "string"
                        }
                      },
                      "required": ["code", "message", "requestId"],
                      "type": "object"
                    }
                  },
                  "required": ["error"],
                  "type": "object"
                }
              }
            },
            "description": "Unexpected internal failure"
          }
        },
        "summary": "Describe the API",
        "tags": ["application"]
      }
    },
    "/api/v1/auth/get-session": {
      "get": {
        "operationId": "betterAuthGetSession",
        "responses": {
          "200": {
            "description": "Native Better Auth response; not wrapped in the domain envelope."
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "security": [{ "bearerAuth": [] }],
        "summary": "Resolve the current session",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/request-password-reset": {
      "post": {
        "operationId": "betterAuthRequestPasswordReset",
        "responses": {
          "200": {
            "description": "Native Better Auth response; not wrapped in the domain envelope."
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "summary": "Request an enumeration-safe password reset",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "betterAuthResetPassword",
        "responses": {
          "200": {
            "description": "Native Better Auth response; not wrapped in the domain envelope."
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "summary": "Reset a password and revoke all sessions",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/send-verification-email": {
      "post": {
        "operationId": "betterAuthSendVerificationEmail",
        "responses": {
          "200": {
            "description": "Native Better Auth response; not wrapped in the domain envelope."
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "summary": "Request email verification",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/sign-in/email": {
      "post": {
        "operationId": "betterAuthSignInEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": { "format": "email", "type": "string" },
                  "password": { "format": "password", "type": "string" }
                },
                "required": ["email", "password"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Native response. Bearer session token is returned in the set-auth-token header.",
            "headers": {
              "set-auth-token": {
                "description": "Bearer session token.",
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "summary": "Sign in with email and password",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "operationId": "betterAuthSignOut",
        "responses": {
          "200": {
            "description": "Native Better Auth response; not wrapped in the domain envelope."
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "security": [{ "bearerAuth": [] }],
        "summary": "Revoke the current session",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/sign-up/email": {
      "post": {
        "operationId": "betterAuthSignUpEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": { "format": "email", "type": "string" },
                  "name": { "type": "string" },
                  "password": { "format": "password", "type": "string" }
                },
                "required": ["email", "name", "password"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Native Better Auth response; not wrapped in the domain envelope."
          },
          "400": { "description": "Native Better Auth validation error." },
          "401": { "description": "Native Better Auth authentication error." }
        },
        "summary": "Register with email and password",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/auth/verify-email": {
      "get": {
        "operationId": "betterAuthVerifyEmail",
        "responses": {
          "302": { "description": "Verification result redirect." },
          "400": { "description": "Native Better Auth validation error." }
        },
        "summary": "Verify an email token",
        "tags": ["native-authentication"]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "UsersController_list_v1",
        "parameters": [],
        "responses": {
          "200": { "description": "Users visible to an administrator." }
        },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      }
    },
    "/api/v1/users/{userId}": {
      "delete": {
        "operationId": "UsersController_delete_v1",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": { "format": "uuid" }
          }
        ],
        "responses": { "204": { "description": "" } },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      },
      "get": {
        "operationId": "UsersController_find_v1",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": { "format": "uuid" }
          }
        ],
        "responses": { "200": { "description": "" } },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      }
    },
    "/api/v1/users/{userId}/role": {
      "patch": {
        "operationId": "UsersController_changeRole_v1",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": { "format": "uuid" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateRoleDto" }
            }
          },
          "required": true
        },
        "responses": { "200": { "description": "" } },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      }
    },
    "/api/v1/users/me": {
      "delete": {
        "operationId": "UsersController_deleteMe_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfirmPasswordDto" }
            }
          },
          "required": true
        },
        "responses": { "204": { "description": "Account deleted." } },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      },
      "get": {
        "operationId": "UsersController_me_v1",
        "parameters": [],
        "responses": { "200": { "description": "" } },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      },
      "patch": {
        "operationId": "UsersController_updateMe_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileDto" }
            }
          },
          "required": true
        },
        "responses": { "200": { "description": "" } },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      }
    },
    "/api/v1/users/me/change-email": {
      "post": {
        "operationId": "UsersController_changeEmail_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangeEmailDto" }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Email verification queued when a change is required."
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      }
    },
    "/api/v1/users/me/change-password": {
      "post": {
        "operationId": "UsersController_changePassword_v1",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePasswordDto" }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed; rotated token is in set-auth-token."
          }
        },
        "security": [{ "bearer": [] }],
        "tags": ["users"]
      }
    }
  },
  "servers": [],
  "tags": []
}
